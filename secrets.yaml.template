# ESPHome Secrets Template
# Copy this file to 'secrets.yaml' and fill in your values
# DO NOT commit secrets.yaml to version control!

# WiFi credentials
wifi_ssid: "Your_WiFi_SSID"
wifi_password: "your_wifi_password"

# Fallback Access Point password
ap_password: "fallback_ap_password"

# Home Assistant API encryption key
# Generate with: esphome run <config>.yaml (it will generate one for you)
api_encryption_key: "your_api_encryption_key_here"

# OTA update password
ota_password: "your_ota_password"

# Optional: MQTT credentials (if using MQTT in addition to API)
mqtt_broker: "192.168.1.100"
mqtt_username: "homeassistant"
mqtt_password: "your_mqtt_password"
